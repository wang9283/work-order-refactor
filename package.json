{
  "name": "feed-group-work-order",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "demo": "node scripts/start-product-demo.mjs",
    "demo:events": "node scripts/product-demo-events.mjs generate",
    "demo:receive": "node scripts/product-demo-events.mjs receive",
    "check:operations": "node scripts/operations-flow-check.mjs",
    "db:init": "tsx server/db/init.ts",
    "db:reset": "tsx server/db/init.ts --reset",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^5.4.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^10.1.7",
    "antd": "^5.21.0",
    "antd-mobile": "^5.38.1",
    "antd-mobile-icons": "^0.3.0",
    "dayjs": "^1.11.21",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "pino-pretty": "^13.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
